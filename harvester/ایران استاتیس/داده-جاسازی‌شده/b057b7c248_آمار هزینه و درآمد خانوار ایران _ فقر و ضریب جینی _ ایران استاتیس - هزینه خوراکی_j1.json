62e\u0627\u0646\u0648\u0627\u0631 \u0627\u06cc\u0631\u0627\u0646 | \u0641\u0642\u0631 \u0648 \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc | \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a\u0627\u062a\u06cc\u0633 - \u0647\u0632\u06cc\u0646\u0647 \u062e\u0648\u0631\u0627\u06a9\u06cc\u060c \u0647\u0632\u06cc\u0646\u0647 \u063a\u06cc\u0631 \u062e\u0648\u0631\u0627\u06a9\u06cc\u060c \u062a\u0648\u0632\u06cc\u0639 \u062f\u0631\u0622\u0645\u062f\u060c \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc","description":"\u0645\u0631\u062c\u0639 \u062c\u0627\u0645\u0639 \u0622\u0645\u0627\u0631 \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646\u061b \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0631\u0633\u0645\u06cc \u0634\u0647\u0631\u06cc \u0648 \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc\u060c \u062f\u0647\u06a9\u06cc \u0648 \u0627\u0633\u062a\u0627\u0646\u06cc\u060c \u0634\u0627\u062e\u0635 \u0641\u0642\u0631 \u0648 \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc \u0628\u0627 \u062f\u0627\u0646\u0644\u0648\u062f \u0627\u06a9\u0633\u0644.","keywords":"\u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631, \u0647\u0632\u06cc\u0646\u0647 \u0632\u0646\u062f\u06af\u06cc, \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631 \u0627\u06cc\u0631\u0627\u0646, \u0622\u0645\u0627\u0631 \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631, \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631, \u0641\u0642\u0631 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646, \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc \u0627\u06cc\u0631\u0627\u0646, \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631 \u0686\u06cc\u0633\u062a\u061f, \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc \u0686\u06cc\u0633\u062a \u0648 \u0686\u06af\u0648\u0646\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f, \u0634\u06a9\u0627\u0641 \u062f\u0631\u0622\u0645\u062f\u06cc \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0686\u0642\u062f\u0631 \u0627\u0633\u062a\u061f, \u0641\u0642\u0631 \u0686\u06af\u0648\u0646\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u061f","author":{"@id":"https://iranstatis.com/author/asieha/","name":"asieha"},"name":"\u0622\u0645\u0627\u0631 \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631 \u0627\u06cc\u0631\u0627\u0646 | \u0641\u0642\u0631 \u0648 \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc | \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a\u0627\u062a\u06cc\u0633 - \u0647\u0632\u06cc\u0646\u0647 \u062e\u0648\u0631\u0627\u06a9\u06cc\u060c \u0647\u0632\u06cc\u0646\u0647 \u063a\u06cc\u0631 \u062e\u0648\u0631\u0627\u06a9\u06cc\u060c \u062a\u0648\u0632\u06cc\u0639 \u062f\u0631\u0622\u0645\u062f\u060c \u0636\u0631\u06cc\u0628 \u062c\u06cc\u0646\u06cc","@id":"https://iranstatis.com/expensesincome/#schema-303604","isPartOf":{"@id":"https://iranstatis.com/expensesincome/#webpage"},"publisher":{"@id":"https://iranstatis.com/#organization"},"image":{"@id":"https://iranstatis.com/wp-content/uploads/2026/10/Infographic-%D8%AF%D8%B1%D8%A2%D9%85%D8%AF-%D9%88-%D9%87%D8%B2%DB%8C%D9%86%D9%87-%D8%AE%D8%A7%D9%86%D9%88%D8%A7%D8%B1-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%DB%B1%DB%B4%DB%B0%DB%B4.webp"},"inLanguage":"fa-IR","mainEntityOfPage":{"@id":"https://iranstatis.com/expensesincome/#webpage"}},{"@type":"Dataset","name":"\u0622\u0645\u0627\u0631 \u0647\u0632\u06cc\u0646\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f \u062e\u0627\u0646\u0648\u0627\u0631 \u0627\u06cc\u0631\u0627\u0646 | \u0641\u0642\u0631 \u0648 \u0636\u0631\u06cc\u0628 \u062